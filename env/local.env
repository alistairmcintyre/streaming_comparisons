# Local (docker-compose) environment , the single source of truth for
# local deployment. Loaded by services via `env_file:` and sourced by the
# Flink submit.sh scripts. See env/aws.example.env for the AWS counterpart.
DEPLOY_ENV=local
AWS_REGION=us-east-1

# ── AWS account (the ONE place the account id is configured) ──
# Everything that needs it derives it from here: the ECR registry used by the
# Docker-backed checks, and the Terraform/workflow inputs. Nothing in the repo
# hardcodes an account id.
# CI cannot read this file (env/aws.env is gitignored), so GitHub Actions takes the
# same value from the repository variable AWS_ACCOUNT_ID instead.
# Only needed for `make test-all`, which pulls the images from ECR.
AWS_ACCOUNT_ID=
# Derived unless you override it: <account>.dkr.ecr.<region>.amazonaws.com/<namespace>
ECR_NAMESPACE=streaming-comparison
#ECR_REGISTRY=

# -- S3 / object store (MinIO) --
S3_ENDPOINT=http://minio:9000
S3_PATH_STYLE=true
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# -- Iceberg catalog (flink-iceberg / spark-iceberg stacks) --
CATALOG_TYPE=rest
CATALOG_URI=http://iceberg-rest:8181
WAREHOUSE=s3://warehouse/

# -- Paimon --
PAIMON_WAREHOUSE=s3://warehouse/paimon
PAIMON_FULL_COMPACT_INTERVAL=1min
# Iceberg-compat storage for Athena/Glue: hadoop-catalog locally (metadata to
# the warehouse), hive-catalog on AWS (registers into Glue). 'disabled' turns off.
PAIMON_ICEBERG_STORAGE=hadoop-catalog

# -- Kafka --
KAFKA_BOOTSTRAP=kafka:9092

# -- Checkpoints --
FLINK_CHECKPOINT_BASE=s3://warehouse/_flink_chk
CHECKPOINT_BASE=s3a://warehouse/_chk

# -- Fluss streaming layer (docker-compose.fluss.yml) ------------------------
FLUSS_BOOTSTRAP=fluss-coordinator:9123
DATALAKE_FORMAT=paimon
FLUSS_PAIMON_WAREHOUSE=s3://warehouse/fluss/paimon
# Local: shared volume (MinIO can't serve Fluss's STS GetSessionToken). On real
# AWS S3 + IAM the STS path works, so this becomes an s3:// path (see aws env).
FLUSS_REMOTE_DATA_DIR=/fluss-remote-data

# Kafka auth: none (PLAINTEXT, in-cluster OSS Kafka) | scram | msk_iam
KAFKA_AUTH=none
