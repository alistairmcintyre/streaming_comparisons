# AWS environment template. Copy to env/aws.env and fill in REPLACE_ME values.
# On AWS, credentials come from the pod/task IAM role , leave the S3/MSK
# secrets blank so the default credential chain is used.
DEPLOY_ENV=aws
AWS_REGION=eu-west-1

# ── AWS account (the ONE place the account id is configured) ──
# Everything that needs it derives it from here: the ECR registry used by the
# Docker-backed checks, and the Terraform/workflow inputs. Nothing in the repo
# hardcodes an account id.
# CI cannot read this file (env/aws.env is gitignored), so GitHub Actions takes the
# same value from the repository variable AWS_ACCOUNT_ID instead.
AWS_ACCOUNT_ID=REPLACE_ME
# Derived unless you override it: <account>.dkr.ecr.<region>.amazonaws.com/<namespace>
ECR_NAMESPACE=streaming-comparison
#ECR_REGISTRY=

# -- S3 / object store (real S3, IAM role , no endpoint, no keys) --
S3_ENDPOINT=
S3_PATH_STYLE=false
S3_ACCESS_KEY=
S3_SECRET_KEY=

# -- Iceberg catalog (native Glue) --
CATALOG_TYPE=glue
CATALOG_URI=
WAREHOUSE=s3://REPLACE_ME-bucket/warehouse/

# -- Paimon --
PAIMON_WAREHOUSE=s3://REPLACE_ME-bucket/paimon
PAIMON_FULL_COMPACT_INTERVAL=10min
# hive-catalog registers the Iceberg-compat metadata into Glue so Athena can read it.
PAIMON_ICEBERG_STORAGE=hive-catalog

# -- Kafka: see the KAFKA_* block near the bottom (OSS Kafka on EKS by default) --

# -- Checkpoints --
FLINK_CHECKPOINT_BASE=s3://REPLACE_ME-bucket/_flink_chk
CHECKPOINT_BASE=s3a://REPLACE_ME-bucket/_chk

# -- Fluss streaming layer (docker-compose.fluss.yml) ------------------------
FLUSS_BOOTSTRAP=REPLACE_ME-fluss-coordinator:9123
DATALAKE_FORMAT=paimon
FLUSS_PAIMON_WAREHOUSE=s3://REPLACE_ME-bucket/fluss/paimon
# remote.data.dir on a shared filesystem, NOT S3. Fluss vends remote-log access via
# STS GetSessionToken, which AWS rejects for the ASSUMED-ROLE creds IRSA gives pods
# ("cannot call GetSessionToken with session credentials"). On EKS this is an EFS
# ReadWriteMany mount (see infra/aws/efs.tf); the Paimon datalake still lives on S3.
FLUSS_REMOTE_DATA_DIR=/fluss-remote-data

# Kafka: OSS Kafka on EKS (Strimzi/AutoMQ) , in-cluster bootstrap, no auth needed.
# For SCRAM set KAFKA_AUTH=scram + KAFKA_USER/KAFKA_PASSWORD; for MSK use msk_iam.
KAFKA_AUTH=none
# e.g. Strimzi: <cluster>-kafka-bootstrap.<namespace>.svc:9092
KAFKA_BOOTSTRAP=REPLACE_ME-kafka-bootstrap.kafka.svc:9092
#KAFKA_USER=
#KAFKA_PASSWORD=
#KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
#KAFKA_SASL_MECHANISM=SCRAM-SHA-512
